<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- World-map marker for a KMH custom site. Driven entirely by
       WorldComponent_KMHSiteMarkers from the server's site snapshot, so it
       carries no map and no faction.

       KMH's OWN art, and two separate images for the two slots. Every vanilla WorldObjectDef pairs
       World/WorldObjects/X with World/WorldObjects/Expanding/X, because the small map dot and the
       zoomed-out icon are drawn in different coordinate spaces. This def used to point BOTH at
       Sites/GenericSite - one vanilla quad texture serving as its own expanding icon - which is
       what made KMH markers read wrong on the world map. -->
  <WorldObjectDef>
    <defName>KMHSite</defName>
    <label>KMH site</label>
    <description>A KMH custom production site.</description>
    <worldObjectClass>KMHPatch.Features.Sites.KMHSiteWorldObject</worldObjectClass>
    <texture>KMHPatch/World/WorldObjects/Generic</texture>
    <expandingIconTexture>KMHPatch/World/WorldObjects/Expanding/Generic</expandingIconTexture>
    <expandingIcon>true</expandingIcon>
    <expandingIconPriority>10</expandingIconPriority>
    <selectable>true</selectable>
    <canHaveFaction>false</canHaveFaction>
    <useDynamicDrawer>true</useDynamicDrawer>
  </WorldObjectDef>

</Defs>
