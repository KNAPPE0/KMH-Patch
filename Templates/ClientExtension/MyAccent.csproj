<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Example KMH client extension as a standalone RimWorld mod.

    Build with:  dotnet build -c Debug
    Output:      1.6/Assemblies/MyAccent.dll  (alongside About/About.xml)

    To install:
      1. Copy the entire mod folder (About/ + 1.6/) into RimWorld's
         Mods folder, OR publish to Steam Workshop.
      2. In-game Mods menu: enable KMH Patch THEN My KMH Accent.
      3. Restart RimWorld.

    Adjust the SDK HintPath to wherever you keep KMH.Sdk.Client.dll
    (typically inside an installed KMH-Patch's 1.6/Assemblies).
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>

    <!-- Build straight into 1.6/Assemblies so RimWorld picks it up.
         Path is relative to this csproj's directory (the mod root). -->
    <OutputPath>1.6\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <DebugType>embedded</DebugType>

    <!-- Don't bundle the SDK or RimWorld refs - both are loaded by
         the time our assembly runs. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference KMH.Sdk.Client (NOT KMHPatch.dll). The SDK is the
         stable contract; KMHPatch internals can shift between
         releases. -->
    <Reference Include="KMH.Sdk.Client">
      <HintPath>..\..\1.6\Assemblies\KMH.Sdk.Client.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
