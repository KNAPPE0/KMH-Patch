<Project Sdk="Microsoft.NET.Sdk">

  <!-- Public SDK for client-side (RimWorld-mod) KMH extensions.
       Mirrors KMH.Sdk.Server's stability contract. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>KMH.Sdk.Client</RootNamespace>
    <AssemblyName>KMH.Sdk.Client</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.3.1</Version>
    <InformationalVersion>1.3.1+rel-283</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Shipped binaries name no folder on the machine that built them. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Output goes into KMHPatch's mod Assemblies folder so a Build of
         either project ships everything in one place. -->
    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- NuGet metadata. `dotnet pack -c Debug` emits .nupkg + .snupkg under Releases/. -->
  <PropertyGroup>
    <PackageId>KMH.Sdk.Client</PackageId>
    <Title>KMH Client SDK</Title>
    <Description>Public API for writing client-side (RimWorld-mod) extensions that plug into Colony Nexus for RimWorld Together. Stable contract that absorbs RWT release upgrades.</Description>
    <Authors>KNAPPE0</Authors>
    <Company>KMH Project</Company>
    <Product>KMH Client SDK</Product>
    <Copyright>Copyright (c) 2026 KNAPPE0</Copyright>
    <PackageTags>rimworld;rimworld-together;rwt;kmh;multiplayer;sdk;mod</PackageTags>
    <PackageProjectUrl>https://github.com/KNAPPE0/KMH-Patch</PackageProjectUrl>
    <RepositoryUrl>https://github.com/KNAPPE0/KMH-Patch</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>EXTENSIONS.md</PackageReadmeFile>
    <PackageReleaseNotes>1.2.1 - Treasury hotfix: fungible food/resource stacking + one-time consolidation of legacy vault fragments, complex-classified items (e.g. eltex) deposit via payload fallback, payload withdraws no longer capped at 10. 1.2.0 - Economy integrity update (auto treasury reset on new save, custom-site value-underreport hardening, disabled-feature dashboard clarity). 1.1.1 - Transport hardening hotfix (loopback-by-default API, auth, connection caps, failed-auth throttle, reconnect-race fix). See EXTENSIONS.md.</PackageReleaseNotes>
    <PackageOutputPath>..\..\Releases</PackageOutputPath>
    <!-- Debug symbols are embedded in the DLL (DebugType=embedded above)
         so no separate .snupkg is produced. -->
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE"        Pack="true" PackagePath="\" Condition="Exists('..\..\LICENSE')" />
    <None Include="..\..\EXTENSIONS.md"  Pack="true" PackagePath="\" Condition="Exists('..\..\EXTENSIONS.md')" />
  </ItemGroup>


  <!-- Stamped with the rel too, and nothing else would catch this copy drifting. -->
  <Target Name="KmhVerifyBuildTag" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TagText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\SubProtocol\KmhProtocol.cs'))</_TagText>
      <_DeclaredTag>$([System.Text.RegularExpressions.Regex]::Match($(_TagText), 'UiBuildTag\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredTag>
      <_InfoTag>$([System.Text.RegularExpressions.Regex]::Match('$(InformationalVersion)', '\+(.*)$').Groups[1].Value)</_InfoTag>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredTag)' != '$(_InfoTag)'" Text="KmhProtocol.UiBuildTag is &quot;$(_DeclaredTag)&quot; but InformationalVersion carries &quot;$(_InfoTag)&quot;. They are what tells two 1.3.1.0 builds apart - bump both together." />
  </Target>

</Project>
