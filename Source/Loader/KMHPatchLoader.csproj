<Project Sdk="Microsoft.NET.Sdk">

  <!-- The version-agnostic stub that RimWorld actually loads (Assemblies/
       KMHPatch.dll). It owns the Mod class + settings, detects which RWT
       generation is present, and loads the matching payload from 1.6/KMHLib. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>KMHPatch</RootNamespace>
    <AssemblyName>KMHPatch</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.3.1</Version>
    <InformationalVersion>1.3.1+rel-283</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Shipped binaries name no folder on the machine that built them. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>

    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>


  <!-- Stamped with the rel too, and nothing else would catch this copy drifting. -->
  <Target Name="KmhVerifyBuildTag" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TagText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\SubProtocol\KmhProtocol.cs'))</_TagText>
      <_DeclaredTag>$([System.Text.RegularExpressions.Regex]::Match($(_TagText), 'UiBuildTag\s*=\s*"([^"]*)"').Groups[1].Value)</_DeclaredTag>
      <_InfoTag>$([System.Text.RegularExpressions.Regex]::Match('$(InformationalVersion)', '\+(.*)$').Groups[1].Value)</_InfoTag>
    </PropertyGroup>
    <Error Condition="'$(_DeclaredTag)' != '$(_InfoTag)'" Text="KmhProtocol.UiBuildTag is &quot;$(_DeclaredTag)&quot; but InformationalVersion carries &quot;$(_InfoTag)&quot;. They are what tells two 1.3.1.0 builds apart - bump both together." />
  </Target>

</Project>
