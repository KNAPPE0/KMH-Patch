<Project Sdk="Microsoft.NET.Sdk">

  <!-- The version-agnostic stub that RimWorld actually loads (Assemblies/
       KMHPatch.dll). It owns the Mod class + settings, detects which RWT
       generation is present, and loads the matching payload from 1.6/KMHLib. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>KMHPatch</RootNamespace>
    <AssemblyName>KMHPatch</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>

    <OutputPath>..\..\1.6\Assemblies</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendConfigurationToOutputPath>false</AppendConfigurationToOutputPath>
    <DebugType>embedded</DebugType>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4633" />
  </ItemGroup>

</Project>
